<?xml version="1.0" encoding="UTF-8"?>
<!--
  智能会议室管理系统 V1.0 —— 后端工程骨架（第 6 周）
  负责人：虞业宸（2025091202009，Git: yycyuyechen）
  技术栈：Spring Boot 3.2.x + JDK 17 + MyBatis 3.5.x + MySQL 8.0.x（见 docs/week06/02_技术栈清单.docx）
  ★ 本周只做"环境验证通路"（登录 + 查询会议室），不实现预约提交、冲突检测等业务（第 9～10 周）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.meetingroom</groupId>
    <artifactId>meeting-room-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>meeting-room-backend</name>
    <description>智能会议室管理系统 V1.0 后端（第 6 周工程骨架：登录 + 查询最小通路）</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-spring-boot.version>3.0.3</mybatis-spring-boot.version>
    </properties>

    <dependencies>
        <!-- Web / REST：提供 HTTP 接口（架构 A2 前后端分离的后端半边） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis：承接 database/ 下的三张表；spring-boot-starter-jdbc 随其引入，HealthController 用其 JdbcTemplate 探活 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>

        <!-- MySQL 8.0 驱动（版本由 spring-boot-dependencies 统一管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          密码摘要：只取 BCryptPasswordEncoder，不引入 spring-boot-starter-security。
          后者会自动装配整条安全过滤链，把本周的登录/查询通路一并拦掉（需额外放行配置），
          与第 6 周"只打通环境验证通路"的范围不符；完整鉴权体系属第 9～10 周。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
