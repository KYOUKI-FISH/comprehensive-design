<?xml version="1.0" encoding="UTF-8"?>
<!--
  智能会议室管理系统 V1.0 —— 后端工程（第 6 周工程骨架）
  小组：第 4 组 ｜ 架构：A2 前后端分离（本模块只提供 REST API）
  技术栈：Spring Boot 3.2.x + JDK 17 + MyBatis 3.5.x + MySQL 8.0.x
  ⚠ 版本号写死，与 docs/week06/02_技术栈清单.docx 一致，不要随手升到"最新版"
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>cn.edu.uestc</groupId>
    <artifactId>meeting-room-backend</artifactId>
    <version>1.0.0</version>
    <name>meeting-room-backend</name>
    <description>智能会议室管理系统 V1.0 后端（第 4 组）</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-spring-boot.version>3.0.3</mybatis-spring-boot.version>
    </properties>

    <dependencies>
        <!-- Web / REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（@NotBlank 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis：简化 CRUD（技术栈清单第 2 项） -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>

        <!-- MySQL 8.0 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          仅引入 spring-security-crypto 以使用 BCryptPasswordEncoder 做密码哈希校验。
          注意：这里【不】引入 spring-boot-starter-security，
          否则会默认开启全套安全拦截、给骨架加上登录过滤链，超出本周范围。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
