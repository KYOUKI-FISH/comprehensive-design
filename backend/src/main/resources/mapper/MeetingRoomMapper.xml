<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- D2 会议室信息表（meeting_room）与 D3 预约记录表（reservation）的 SQL -->
<mapper namespace="com.meetingroom.mapper.MeetingRoomMapper">

    <!-- 按条件查询会议室（DFD 加工 P2 查询会议室 / FR-05、FR-06） -->
    <select id="selectByCondition" resultType="com.meetingroom.entity.MeetingRoom">
        SELECT id, name, location, capacity, equipment, status, remark, created_at, updated_at
        FROM meeting_room
        <where>
            <if test="location != null and location != ''">
                AND (location LIKE CONCAT('%', #{location}, '%')
                     OR name LIKE CONCAT('%', #{location}, '%'))
            </if>
            <if test="minCapacity != null">
                AND capacity &gt;= #{minCapacity}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id
    </select>

    <!--
      查询一批会议室在某天的已占用时段（只读，供查询页展示）。
      ★ 半开区间 [start, end) 的判定规则不在这里，这里只取"占用行"本身：
        同一天、状态为待开始/进行中的预约，其 [start_time, end_time) 即为已占用。
    -->
    <select id="selectOccupiedSlots" resultType="com.meetingroom.dto.OccupiedSlotDTO">
        SELECT room_id AS roomId, start_time AS startTime, end_time AS endTime
        FROM reservation
        WHERE reserve_date = #{date}
          AND status IN ('PENDING', 'ONGOING')
          AND room_id IN
        <foreach collection="roomIds" item="roomId" open="(" separator="," close=")">
            #{roomId}
        </foreach>
        ORDER BY room_id, start_time
    </select>

    <!-- 按ID查会议室（第 9 周详情页用） -->
    <select id="selectById" resultType="com.meetingroom.entity.MeetingRoom">
        SELECT id, name, location, capacity, equipment, status, remark, created_at, updated_at
        FROM meeting_room
        WHERE id = #{id}
        LIMIT 1
    </select>

    <!--
      查某会议室某天的占用时段（只读版，供详情页展示用）。
      ★ 只取"占用行"，判定不在 SQL 里。
      ★ 排除 CANCELLED：已取消的预约时段已释放（NF-08「取消后时段立即释放」）。
      ⚠️ 这是【快照读】：不锁行。详情页是纯展示，用它没问题。
        冲突检测<strong>不能</strong>用这个（会读到旧快照，见 selectRoomOccupiedSlotsForUpdate）。
    -->
    <select id="selectRoomOccupiedSlots" resultType="com.meetingroom.dto.OccupiedSlotDTO">
        SELECT room_id AS roomId, start_time AS startTime, end_time AS endTime
        FROM reservation
        WHERE reserve_date = #{date}
          AND room_id = #{roomId}
          AND status &lt;&gt; 'CANCELLED'
        ORDER BY start_time
    </select>

    <!--
      查某会议室某天的占用时段（【锁定读】版，专供冲突检测使用）。
      ★★★ 末尾的 FOR UPDATE 不是可选项 ★★★
      MySQL 默认隔离级别 REPEATABLE READ 下：
        · 普通 SELECT 是【快照读】，读的是事务开始那一刻的快照——看不到别的事务刚提交的记录；
        · SELECT ... FOR UPDATE 是【当前读】，读的是最新已提交数据。
      第 9 周并发自测实际打出的问题：这个查询原本用普通 SELECT（快照读），
      导致 10 个并发请求<strong>全都通过了冲突检测</strong>，产生 10 条有效预约（超卖）。
      锁 meeting_room 行本身<strong>不够</strong>——它只保证"同一会议室的请求排队"，
      但排队后每个事务仍读到各自的旧快照，于是全都判"无冲突"。

      ★ 锁顺序：同一事务内先锁 meeting_room 行（lockById），再锁该会议室当日的
        reservation 行范围（此处）。所有并发请求顺序一致 → 不会死锁。
      ★ 必须在事务内调用（否则 FOR UPDATE 立即释放，等于没锁）。
    -->
    <select id="selectRoomOccupiedSlotsForUpdate" resultType="com.meetingroom.dto.OccupiedSlotDTO">
        SELECT room_id AS roomId, start_time AS startTime, end_time AS endTime
        FROM reservation
        WHERE reserve_date = #{date}
          AND room_id = #{roomId}
          AND status &lt;&gt; 'CANCELLED'
        ORDER BY start_time
        FOR UPDATE
    </select>

    <!--
      ★★ 锁定会议室行（第 9 周并发防超卖的关键，FR-09 + NF-07）★★
      为什么锁 meeting_room 行而不是 reservation 行：
        并发提交时，冲突方那条预约记录【还不存在】，锁不到它；
        而会议室行一定存在，锁它就能把"同一会议室"的并发请求串行化。
      配合 @Transactional 使用：本语句必须与后续的冲突查询、INSERT 在同一事务里，
      否则锁一放就失效，等于没锁。
    -->
    <select id="lockById" resultType="com.meetingroom.entity.MeetingRoom">
        SELECT id, name, location, capacity, equipment, status, remark, created_at, updated_at
        FROM meeting_room
        WHERE id = #{id}
        FOR UPDATE
    </select>

</mapper>
