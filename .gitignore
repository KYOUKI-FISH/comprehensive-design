# ---------------------------------------------------------------------------
# 智能会议室管理系统 —— 第 4 组
# 仅忽略「本机产生的临时文件 / 编辑器缓存」，不忽略任何项目交付材料。
# 注意：docs/ 下的所有需求、需求、图表、记录类文件必须提交，不得加入本文件。
# ---------------------------------------------------------------------------

# 工作区记忆与工具缓存（WorkBuddy / 本地助手生成，不属于项目交付物）
.workbuddy/
**/.workbuddy/

# Microsoft Office / WPS 临时锁文件
~$*.doc
~$*.docx
~$*.xls
~$*.xlsx
~$*.ppt
~$*.pptx
.~lock.*#

# 操作系统与编辑器噪音
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*~
*.swp
.vscode/
.idea/

# 构建与依赖产物（第 5 周开始编码后生效，提前占位）
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.log
