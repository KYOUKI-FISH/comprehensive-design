<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', fontFamily: '"Microsoft YaHei", Arial, sans-serif', position: 'relative' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 76, background: '#1E4FA8', display: 'flex', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>核心规则：半开区间，首尾相接不算冲突</Text>
        <Text style={{ fontSize: 16, color: '#BFD0EA' }}>01 · 需求分析</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 96, width: 690, height: 84, background: '#F7F9FC', border: '1px solid #D6DCE5', display: 'flex', flexDirection: 'column', justifyContent: 'center', padding: '0 24px', gap: 8 }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', letterSpacing: 1 }}>冲突判定式（FR-09，三份文档同一句话）</Text>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E4FA8' }}>start_new &lt; end_old　且　end_new &gt; start_old</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 196, width: 690, height: 250, border: '1px solid #E5E7EB', background: '#FFFFFF', padding: 0 }}>
        <SVG width={688} height={248} viewBox="0 0 688 248">
            <text x="24" y="34" fontSize="16" fill="#4A5568">情形一：首尾相接 —— 允许</text>
            <rect x="110" y="48" width="230" height="38" fill="#1E4FA8" />
            <text x="225" y="72" fontSize="15" fill="#FFFFFF" textAnchor="middle">10:00–11:00 已预约</text>
            <rect x="340" y="48" width="230" height="38" fill="#A9C4E8" />
            <text x="455" y="72" fontSize="15" fill="#1A2230" textAnchor="middle">11:00–12:00 新提交</text>
            <line x1="340" y1="42" x2="340" y2="92" stroke="#1E4FA8" strokeWidth="2" />
