            <text x="24" y="158" fontSize="16" fill="#4A5568">情形二：部分重叠 —— 拒绝</text>
            <rect x="110" y="172" width="230" height="38" fill="#1E4FA8" />
            <text x="225" y="196" fontSize="15" fill="#FFFFFF" textAnchor="middle">10:00–11:00 已预约</text>
            <rect x="225" y="172" width="230" height="38" fill="#D9534F" opacity="0.55" />
