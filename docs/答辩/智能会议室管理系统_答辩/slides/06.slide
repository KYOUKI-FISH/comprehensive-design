    <Box style={{ position: 'absolute', left: 790, top: 96, width: 430, display: 'flex', flexDirection: 'column', gap: 16 }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>配套的时间规则</Text>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>不跨天</Text>
            <Text style={{ fontSize: 16, color: '#4A5568' }}>单次预约只能落在同一天内</Text>
        </Box>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>不超过 8 小时</Text>
            <Text style={{ fontSize: 16, color: '#4A5568' }}>防止一次占满整天</Text>
        </Box>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>开始时间晚于当前</Text>
            <Text style={{ fontSize: 16, color: '#4A5568' }}>不允许追溯提交</Text>
        </Box>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>改／取消提前 30 分钟</Text>
            <Text style={{ fontSize: 16, color: '#4A5568' }}>距开始不足 30 分钟即拒绝</Text>
        </Box>
