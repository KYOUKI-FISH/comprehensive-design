<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', fontFamily: '"Microsoft YaHei", Arial, sans-serif', position: 'relative' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 76, background: '#1E4FA8', display: 'flex', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>6 个用例规约，覆盖两条角色主线</Text>
        <Text style={{ fontSize: 16, color: '#BFD0EA' }}>01 · 需求分析</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 100, width: 540, display: 'flex', flexDirection: 'column' }}>
        <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'baseline', gap: 12, paddingBottom: 12, borderBottom: '2px solid #1E4FA8' }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>普通用户</Text>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>UC-U01 – U05　FR-01、05、07 – 13</Text>
        </Box>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 16, marginTop: 20 }}>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>UC-U01　登录与角色隔离</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>账号密码 + 状态校验；普通用户登录后不出现任何管理入口</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>UC-U03　提交预约</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>必填项、时间规则、会议室状态、时间冲突四道校验，通过即落库无审批</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>UC-U04　查看／修改我的预约</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>只显示本人记录；距开始超过 30 分钟才可改，改后重新检测冲突（排除自身）</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>UC-U05　取消我的预约</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>校验归属与 30 分钟时限；取消后时段立即释放，历史记录保留</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 660, top: 100, width: 560, display: 'flex', flexDirection: 'column' }}>
        <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'baseline', gap: 12, paddingBottom: 12, borderBottom: '2px solid #1E4FA8' }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>管理员</Text>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>UC-A03 – A05　FR-03、04、14 – 16</Text>
        </Box>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 16, marginTop: 20 }}>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>UC-A03　管理会议室</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>新增、修改、删除（有预约则拒绝）、启用与停用</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>UC-A04　查看和处理预约</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>按日期、状态、会议室筛选全部预约；强制取消异常预约并填原因</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>UC-A05　用户与审计</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>账号启用／停用、角色调整；操作日志可查，普通用户访问返回 403</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'column', gap: 6, marginTop: 2, padding: 16, background: '#F7F9FC' }}>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.7 }}>处理预约＝强制取消或更正错误记录，<br />不是逐条审批——方案 A 没有审批环节。</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 560, width: 1160, display: 'flex', flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ padding: '12px 16px', border: '1px solid #D6DCE5' }}><Text style={{ fontSize: 17, color: '#1A2230' }}>登录</Text></Box>
        <Text style={{ fontSize: 18, color: '#1E4FA8' }}>→</Text>
        <Box style={{ padding: '12px 16px', border: '1px solid #D6DCE5' }}><Text style={{ fontSize: 17, color: '#1A2230' }}>查询可用会议室</Text></Box>
        <Text style={{ fontSize: 18, color: '#1E4FA8' }}>→</Text>
        <Box style={{ padding: '12px 16px', border: '1px solid #1E4FA8', background: '#E8EFF8' }}><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8' }}>提交预约 · 冲突检测</Text></Box>
        <Text style={{ fontSize: 18, color: '#1E4FA8' }}>→</Text>
        <Box style={{ padding: '12px 16px', border: '1px solid #D6DCE5' }}><Text style={{ fontSize: 17, color: '#1A2230' }}>我的预约</Text></Box>
        <Text style={{ fontSize: 18, color: '#1E4FA8' }}>→</Text>
        <Box style={{ padding: '12px 16px', border: '1px solid #D6DCE5' }}><Text style={{ fontSize: 17, color: '#1A2230' }}>取消 / 强制取消</Text></Box>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 660, width: 1160, display: 'flex', flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>智能会议室管理系统 V1.0 · 第 4 组答辩</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>05 / 20</Text>
    </Box>
</Slide>
