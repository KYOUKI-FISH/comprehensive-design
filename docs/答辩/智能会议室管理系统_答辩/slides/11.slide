<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', fontFamily: '"Microsoft YaHei", Arial, sans-serif', position: 'relative' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 76, background: '#1E4FA8', display: 'flex', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>14 条接口冻结：统一响应 + 六条鉴权规则</Text>
        <Text style={{ fontSize: 16, color: '#BFD0EA' }}>02 · 概要设计</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 96, width: 1160 }}>
        <Table
            style={{ width: 1160, height: 474 }}
            defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#1A2230' }}
            defaultCellStyle={{ border: { bottom: { width: 1, color: '#E5E7EB' } }, padding: 8 }}
            cells={[
                [
                    { text: '#', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                    { text: '接口', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                    { text: '方法与路径', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                    { text: '需求', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                    { text: '鉴权', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } }
                ],
                ['1', '登录', 'POST /api/auth/login', 'FR-01、02', '公开'],
                ['2', '登出', 'POST /api/auth/logout', 'NF-04', '登录'],
                ['3', '会议室列表', 'GET /api/rooms', 'FR-05、06', '登录'],
                ['4', '占用时段', 'GET /api/rooms/{id}/occupancy', 'FR-17', '登录'],
                ['5', '提交预约', 'POST /api/bookings', 'FR-07～10', '登录'],
                ['6', '我的预约', 'GET /api/bookings/mine', 'FR-11', '登录'],
                ['7', '修改预约', 'PUT /api/bookings/{id}', 'FR-12', '本人'],
                ['8', '取消预约', 'DELETE /api/bookings/{id}', 'FR-13', '本人'],
                ['9', '全部预约', 'GET /api/admin/bookings', 'FR-15、19', '管理员'],
                ['10', '强制取消', 'PUT /api/admin/bookings/{id}/cancel', 'FR-16', '管理员'],
                ['11', '会议室管理', 'GET／POST／PUT／DELETE /api/admin/rooms', 'FR-03、04', '管理员'],
                ['12', '用户管理', 'GET／POST／PUT /api/admin/users', 'FR-14', '管理员'],
                ['13', '操作日志', 'GET /api/admin/logs', 'NF-14', '管理员'],
                [{ text: '14', textStyle: { color: '#8B97A8' } }, { text: '利用率概览', textStyle: { color: '#8B97A8' } }, { text: 'GET /api/admin/stats/utilization', textStyle: { color: '#8B97A8' } }, { text: 'FR-20', textStyle: { color: '#8B97A8' } }, { text: '管理员', textStyle: { color: '#8B97A8' } }]
            ]}
        />
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 578, width: 560, display: 'flex', flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230' }}>统一响应</Text>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6 }}>{"{ code, message, data }"}，code = 200 为成功，前端按 code 判定并翻译中文提示</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 660, top: 578, width: 560, display: 'flex', flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230' }}>鉴权 R1～R6</Text>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6 }}>缺令牌 401；越权 403；只能操作本人预约；已取消时段立即释放可再约</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 660, width: 1160, display: 'flex', flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>智能会议室管理系统 V1.0 · 第 4 组答辩</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>11 / 20</Text>
    </Box>
</Slide>
