<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', fontFamily: '"Microsoft YaHei", Arial, sans-serif', position: 'relative' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 76, background: '#1E4FA8', display: 'flex', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>核心规则：半开区间，首尾相接不算冲突</Text>
        <Text style={{ fontSize: 16, color: '#BFD0EA' }}>01 · 需求分析</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 96, width: 700, height: 96, background: '#F7F9FC', border: '1px solid #D6DCE5', display: 'flex', flexDirection: 'column', justifyContent: 'center', padding: '0 24px', gap: 8 }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', letterSpacing: 1 }}>冲突判定式（FR-09，四份文档同一句话）</Text>
        <Text style={{ fontSize: 25, fontWeight: 'bold', color: '#1E4FA8' }}>start_new &lt; end_old　且　end_new &gt; start_old</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 208, width: 700, height: 286, border: '1px solid #E5E7EB', background: '#FFFFFF' }}>
        <SVG width={698} height={284} viewBox="0 0 698 284">
            <text x="24" y="36" fontSize="17" fill="#4A5568">情形一：首尾相接 —— 允许</text>
            <rect x="110" y="52" width="240" height="42" fill="#1E4FA8" />
            <text x="230" y="79" fontSize="16" fill="#FFFFFF" textAnchor="middle">10:00–11:00 已预约</text>
            <rect x="350" y="52" width="240" height="42" fill="#A9C4E8" />
            <text x="470" y="79" fontSize="16" fill="#1A2230" textAnchor="middle">11:00–12:00 新提交</text>
            <line x1="350" y1="44" x2="350" y2="102" stroke="#1E4FA8" strokeWidth="2" />
            <text x="350" y="124" fontSize="15" fill="#1E4FA8" textAnchor="middle">相接点 11:00，判定式两个不等式都不成立</text>

            <text x="24" y="176" fontSize="17" fill="#4A5568">情形二：部分重叠 —— 拒绝</text>
            <rect x="110" y="192" width="240" height="42" fill="#1E4FA8" />
            <text x="230" y="219" fontSize="16" fill="#FFFFFF" textAnchor="middle">10:00–11:00 已预约</text>
            <rect x="230" y="192" width="240" height="42" fill="#D9534F" opacity="0.45" />
            <text x="500" y="219" fontSize="16" fill="#D9534F" textAnchor="middle">10:30–11:30</text>
            <text x="292" y="258" fontSize="15" fill="#D9534F">重叠区 10:30–11:00 → 返回 409 与占用时段</text>
        </SVG>
    </Box>

    <Box style={{ position: 'absolute', left: 800, top: 96, width: 420, display: 'flex', flexDirection: 'column', gap: 16 }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>配套的三条时间规则</Text>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>不跨天 · 单次 ≤ 8 小时</Text>
            <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>防止一次占满整天</Text>
        </Box>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>开始时间必须晚于当前</Text>
            <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>不允许追溯提交</Text>
        </Box>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>改／取消提前 30 分钟</Text>
            <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6 }}>距开始不足 30 分钟即拒绝</Text>
        </Box>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 4, padding: 14, background: '#E8EFF8' }}>
            <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.6 }}>口径由需求评审 R-04 定下，需求清单 · 用例规约 · 接口文档 · SQL 四处一致。</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 520, width: 700, height: 62, background: '#F7F9FC', borderLeft: '4px solid #1E4FA8', display: 'flex', alignItems: 'center', padding: '0 24px' }}>
        <Text style={{ fontSize: 18, color: '#1A2230' }}>为什么较真这一点：首尾相接是真实使用中最常见的连续预约，判错一次就会被当成缺陷。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 660, width: 1160, display: 'flex', flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>智能会议室管理系统 V1.0 · 第 4 组答辩</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>03 / 10</Text>
    </Box>
</Slide>
