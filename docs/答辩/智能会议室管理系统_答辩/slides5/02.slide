<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', fontFamily: '"Microsoft YaHei", Arial, sans-serif', position: 'relative' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 76, background: '#1E4FA8', display: 'flex', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>需求从哪来：基线、范围、用例</Text>
        <Text style={{ fontSize: 16, color: '#BFD0EA' }}>01 · 需求分析</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 96, width: 1160, height: 96, background: '#E8EFF8', display: 'flex', flexDirection: 'column', justifyContent: 'center', padding: '0 28px', gap: 6 }}>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', letterSpacing: 1 }}>一句话定位</Text>
        <Text style={{ fontSize: 21, color: '#1A2230', lineHeight: 1.45 }}>面向高校教研室的会议室预约系统：普通用户查空档、提交与取消预约，管理员管房间、审批与统计。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 216, width: 1160, display: 'flex', flexDirection: 'row' }}>
        <Box style={{ width: 300, display: 'flex', flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>20</Text>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>条功能需求</Text>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>FR-01 ～ FR-20，可追溯到用例</Text>
        </Box>
        <Box style={{ width: 300, display: 'flex', flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>15</Text>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>条非功能需求</Text>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>每条都写明验证方式</Text>
        </Box>
        <Box style={{ width: 300, display: 'flex', flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>6</Text>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>份用例规约</Text>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>U01/U03/U04/U05 + A03/A04</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 366, width: 560, display: 'flex', flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>主链路只有五步</Text>
        <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.8 }}>登录 → 查某日空档 → 提交预约 → 查看／修改 → 取消或到期自动结束。<br />两条角色分支：管理员管房间、处理预约与统计。</Text>
        <Box style={{ display: 'flex', flexDirection: 'column', gap: 4, padding: 14, background: '#F7F9FC', borderLeft: '3px solid #3D7BD9' }}>
            <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.6 }}>用例不追求数量：6 份规约覆盖全部 20 条功能和所有异常分支。</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 700, top: 366, width: 520, display: 'flex', flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>范围之外，9 项明确不做</Text>
        <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.75 }}>人脸识别、物联网控制、3D 场景、智能推荐、周期／批量预约、多级审批、消息推送、统一身份认证对接、移动端原生应用。</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8', lineHeight: 1.7 }}>写进需求清单，也不画进任何图表——避免"综合管理平台"式模糊口径。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 574, width: 1160, height: 62, background: '#F7F9FC', borderLeft: '4px solid #1E4FA8', display: 'flex', alignItems: 'center', padding: '0 24px' }}>
        <Text style={{ fontSize: 19, color: '#1A2230' }}>需求可验收的标准不是"写全了"，而是每条都能被一个用例和一次测试命中。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 660, width: 1160, display: 'flex', flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>智能会议室管理系统 V1.0 · 第 4 组答辩</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>02 / 10</Text>
    </Box>
</Slide>
